<?xml version="1.0" encoding="utf-8"?>
<subsection xml:id="weights">
  <title>Weights</title>
  <p>
    Grades will be calculated using the weights below.
  </p>

  <assemblage xml:id="evaluation_criteria">
    <title>Evaluation Criteria</title>
    <tabular>
      <row header="yes" bottom="minor" >
	<cell>Grade Category</cell>
	<cell>Weight</cell>
      </row>
      <row>
	<cell>Quizzes</cell>
	<cell>50%</cell>
      </row>
      <row>
	<cell>Midterm Exam</cell>
	<cell>25%</cell>
      </row>
      <row>
	<cell>Final Exam</cell>
	<cell>25%</cell>
      </row>
    </tabular>
  </assemblage>
</subsection>
