<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE article [
<!ENTITY % coursevars SYSTEM "../course-vars.ent">
%coursevars;
]>
<subsection xml:id="exams" component="exams">
  <title>Exams</title>
  <p>
    There will be one in-class midterm exam and a cumulative final exam.
    Both exams will be given during the regular class meeting time in our usual classroom.
    The exams are scheduled as follows:
  </p>

  <assemblage xml:id="exam_schedule">
    <tabular halign="center">
      <row header="yes" bottom="minor" >
	<cell>Exam</cell>
	<cell>Date</cell>
      </row>
      <row>
	<cell>Midterm Exam</cell>
	<cell>&midterm;, &year;</cell>
      </row>
      <row>
	<cell>Final Exam</cell>
	<cell>&finalexam;, &year;</cell>
      </row>
    </tabular>
  </assemblage>

  <p>
    All exams are completed individually and are governed by the <xref ref="academic_honor_code" text="title"/>.
    The policy for a missed exam is described in <xref ref="make-up_policy"/>.
  </p>

  <warning xml:id="exam_warning">
    <p>
      <ul>
	<li>
	  <p>The instructor reserves the right to modify the schedule of in-class exams.</p>
	</li>
	<li>
	  <p>
	    The final exam date and time are scheduled in advance.
	    Failure to appear at the final exam will result in a grade of zero for the exam.
	  </p>
	</li>
      </ul>
    </p>
  </warning>
</subsection>
